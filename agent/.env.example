# Control Plane gRPC server address
CONTROL_PLANE_ADDR=localhost:50051

# Unique agent identifier (must be set)
AGENT_ID=agent-001

# Hostname for this host (auto-detected if not set)
HOSTNAME=docker-host-01

# Docker Engine socket or TCP address
DOCKER_HOST=unix:///var/run/docker.sock

# Heartbeat interval in seconds
HEARTBEAT_INTERVAL=30

# Agent listening port (for future features like local health check)
PORT=9000

# TLS/mTLS Configuration (Phase 7)
# Development: set to false for insecure connection
# Production: set to true and provide certificate paths
# Generate certs: ./scripts/generate-certs.sh -Mode dev -OutputDir ./certs
TLS_ENABLED=false
TLS_CERT_PATH=./certs/client-cert.pem
TLS_KEY_PATH=./certs/client-key.pem
TLS_CA_PATH=./certs/ca-cert.pem
