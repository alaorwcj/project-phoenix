# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docker_platform?schema=public"

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Authentication
JWT_SECRET=change-me-in-production-please-use-strong-secret
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# gRPC
GRPC_PORT=50051

# TLS/mTLS Configuration (Phase 7)
# Development: set to false for insecure connection
# Production: set to true and provide certificate paths
# Generate certs: ./scripts/generate-certs.ps1 -Mode dev -OutputDir ./certs
TLS_ENABLED=false
TLS_CERT_PATH=./certs/server-cert.pem
TLS_KEY_PATH=./certs/server-key.pem
TLS_CA_PATH=./certs/ca-cert.pem

# External Services
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# Logging
LOG_LEVEL=info