# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docker_platform?schema=public"

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Authentication
JWT_SECRET=change-me-in-production-please-use-strong-secret
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# gRPC
GRPC_PORT=50051
GRPC_TLS_ENABLED=false
GRPC_CERT_PATH=
GRPC_KEY_PATH=
GRPC_CA_PATH=

# External Services
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# Logging
LOG_LEVEL=info