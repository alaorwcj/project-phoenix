{
  "name": "@docker-platform/control-plane",
  "version": "0.1.0",
  "description": "Control Plane API for Docker Platform - Multi-Tenant Container Orchestration",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "proto:generate": "protoc --plugin=node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/proto --ts_proto_opt=nestJs=true ./proto/*.proto"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0",
    "@prisma/client": "^5.0.0",
    "@types/bull": "^3.15.9",
    "bcrypt": "^5.1.0",
    "bull": "^4.16.5",
    "dotenv": "^16.3.0",
    "fastify": "^4.24.0",
    "jsonwebtoken": "^9.0.0",
    "redis": "^6.2.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "prisma": "^5.0.0",
    "protobufjs": "^8.7.2",
    "protoc": "^36.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "ts-proto": "^2.12.1",
    "typescript": "^5.0.0"
  }
}
