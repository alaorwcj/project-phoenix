generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum HostStatus {
  PENDING
  ONLINE
  OFFLINE
  DECOMMISSIONED
}

enum ContainerStatus {
  PENDING
  CREATING
  RUNNING
  STOPPING
  STOPPED
  FAILED
  UNKNOWN
}

enum ContainerRestartPolicy {
  NO
  ALWAYS
  ON_FAILURE
  UNLESS_STOPPED
}

model Tenant {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  slug         String        @unique
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  users        User[]
  environments Environment[]
  hosts        Host[]
  containers   Container[]
  jobs         Job[]
  auditLogs    AuditLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Environment {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  name      String
  slug      String
  type      EnvironmentType
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("environments")
}

model Host {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  name         String
  hostname     String
  agentId      String?    @unique @map("agent_id")
  status       HostStatus @default(PENDING)
  lastHeartbeat DateTime? @map("last_heartbeat")
  metadata     Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  containers   Container[]

  @@unique([tenantId, hostname])
  @@index([tenantId])
  @@map("hosts")
}

model Container {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  hostId          String                 @map("host_id") @db.Uuid
  dockerId        String                 @map("docker_id")
  name            String
  image           String
  status          ContainerStatus        @default(PENDING)
  restartPolicy   ContainerRestartPolicy @default(NO)
  environmentVars Json?                  @map("environment_vars")
  resourceLimits  Json?                  @map("resource_limits")
  portBindings    Json?                  @map("port_bindings")
  metadata        Json?
  createdAt       DateTime               @default(now()) @map("created_at")
  startedAt       DateTime?              @map("started_at")
  stoppedAt       DateTime?              @map("stopped_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dockerId])
  @@unique([tenantId, hostId, name])
  @@index([tenantId])
  @@index([hostId])
  @@index([status])
  @@map("containers")
}

model ContainerLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  containerId  String   @map("container_id") @db.Uuid
  stream       String   // stdout, stderr
  data         Bytes
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([containerId])
  @@index([timestamp])
  @@map("container_logs")
}

model Job {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  jobId         String   @unique @map("job_id") // Bull job ID
  jobType       String   @map("job_type") // container:start, container:stop, image:pull
  status        String   // pending, processing, completed, failed
  progress      Int      @default(0)
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3) @map("max_attempts")
  error         String?
  result        Json?
  containerId   String?  @map("container_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([jobType])
  @@index([status])
  @@index([createdAt])
  @@map("jobs")
}

enum AuditAction {
  CONTAINER_START
  CONTAINER_STOP
  CONTAINER_DELETE
  HOST_REGISTER
  HOST_DEREGISTER
  ENVIRONMENT_CREATE
  ENVIRONMENT_UPDATE
  ENVIRONMENT_DELETE
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  SECRET_CREATE
  SECRET_DELETE
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  resource   String      // e.g. "container", "host", "environment"
  resourceId String?     @map("resource_id")
  metadata   Json?       // extra context: old values, request IP, etc.
  result     String      // "success" | "failure"
  error      String?
  createdAt  DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}