# Docker Platform - Environment Variables (production)
# Copy to .env and fill in values before deploying

# PostgreSQL
POSTGRES_PASSWORD=change-me-in-production

# Redis
REDIS_PASSWORD=change-me-in-production

# JWT
JWT_SECRET=change-me-minimum-32-characters-long

# Agent
AGENT_ID=agent-prod-001

# Dashboard
VITE_API_URL=
